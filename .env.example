# Server-only (Vercel Project Settings > Environment Variables).
# These are used by /api/posts and /api/reactions and are NEVER sent to the
# browser. The anon key is public by design; RLS in supabase/schema.sql is the
# security boundary. A service role key is optional and bypasses RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy fallbacks (used automatically if the names above are absent):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
